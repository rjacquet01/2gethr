# Names only: never commit values. Real values live in Vercel and .env.local.

# --- SMS ---
# "twilio" (default) or "telnyx". Anything else, or unset, means Twilio.
SMS_PROVIDER=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Telnyx
TELNYX_API_KEY=
# The sending number in E.164, e.g. the toll-free +18662776365
TELNYX_FROM_NUMBER=
# Optional: messaging profile to send through
TELNYX_MESSAGING_PROFILE_ID=
# Base64 Ed25519 public key that verifies Telnyx webhooks (Mission Control > Keys & Credentials)
TELNYX_PUBLIC_KEY=
